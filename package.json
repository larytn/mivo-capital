    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "jose": "^6.2.8",
    "jsonwebtoken": "^9.0.3",
    "lightweight-charts": "^5.2.1",
    "multer": "^2.2.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "next-cloudinary": "^6.17.5",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
