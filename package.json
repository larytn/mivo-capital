{
  "name": "mivo-capital",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "db:sync:ecosystem": "prisma db execute --schema prisma/schema.prisma --file prisma/ecosystem-schema-sync.sql",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:copy-trading": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/copy-trading.test.mjs",
