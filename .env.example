# Required for the launch workspace
DATABASE_URL=
JWT_SECRET=
META_API_TOKEN=
CRON_SECRET=

# Required in the deployed environment for spot-metal history (XAU/XAG/XPT/XPD).
# Forex can use the built-in Yahoo fallback when this key is not configured.
TWELVE_DATA_API_KEY=

# Optional: if omitted, community posts stay private for admin review
OPENAI_API_KEY=
COMMUNITY_MODERATION_MODEL=

# Optional: media uploads in Community and Trader Chat
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: set to the deployed site URL for generated links
NEXT_PUBLIC_APP_URL=

# VIP Signals subscriptions (create monthly and annual plans in Paystack and use their plan codes).
# Register https://your-domain/api/vip-membership/webhook in Paystack to process subscription events.
PAYSTACK_SECRET_KEY=
PAYSTACK_VIP_MONTHLY_PLAN_CODE=
PAYSTACK_VIP_ANNUAL_PLAN_CODE=
# Optional separate signing secret when configured for Paystack's timestamped webhook signatures.
PAYSTACK_WEBHOOK_SECRET=
